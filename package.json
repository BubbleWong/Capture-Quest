{
  "name": "capture-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A PWA camera scavenger hunt game for homes and schools.",
  "main": "server/localWorker.js",
  "scripts": {
    "start": "node server/localWorker.js",
    "dev": "npm run build && wrangler dev --config cloudflare/wrangler.jsonc",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test scripts/tests/*.test.mjs cloudflare/test/*.test.mjs",
    "ci": "npm run check && npm test",
    "smoke": "node scripts/hybrid-smoke.mjs",
    "load:50": "node scripts/hybrid-load-50.mjs",
    "worker": "node server/localWorker.js",
    "db:migrate": "node server/localWorker.js --migrate",
    "build": "node scripts/build-assets.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:hybrid": "npm run build && node scripts/run-hybrid-gate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "pg": "^8.12.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "miniflare": "^5.20261023.1-beta",
    "qrcode": "^1.5.4",
    "wrangler": "^4.154.0",
    "ws": "^8.22.0"
  }
}
